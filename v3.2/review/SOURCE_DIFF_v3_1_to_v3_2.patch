+  }
+}
+v<-do.call(rbind,values);g<-do.call(rbind,gradients)
+write.csv(v,file.path(out,"value_comparison.csv"),row.names=FALSE)
+write.csv(g,file.path(out,"gradient_comparison.csv"),row.names=FALSE)
