+status<-list(stage=stage,status=if(value_pass&&gradient_pass)"PASS" else "FAIL_REPRODUCED",purpose="synthetic_parameter_evaluation_only_no_posterior_sampling",value_count=nrow(v),gradient_count=nrow(g),value_pass=value_pass,gradient_pass=gradient_pass,max_value_abs_error=max(v$AbsError),max_value_scaled_error=max(v$ScaledError),value_tolerance="abs(error)<1e-10*max(1,abs(reference_logprob))",max_gradient_scaled_error=max(g$ScaledError),rstan_version=as.character(packageVersion("rstan")),R_version=R.version.string,production_source=source_file,created_utc=format(Sys.time(),tz="UTC",usetz=TRUE))
